            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"comment_html\": \"<p></p>\",\n  \"access\": \"INTERNAL\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/{{project_id}}/work-items/{{work_item_id}}/comments/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", "{{project_id}}", "work-items", "{{work_item_id}}", "comments", ""]
            }
