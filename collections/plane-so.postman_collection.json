              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", "{{project_id}}", "work-items", "{{work_item_id}}", ""]
            }
          }
        },
        {
          "name": "List comments on a work item.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/{{project_id}}/work-items/{{work_item_id}}/comments/",
