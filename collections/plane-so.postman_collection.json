            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"url\": \"\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/{{project_id}}/work-items/{{work_item_id}}/links/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", "{{project_id}}", "work-items", "{{work_item_id}}", "links", ""]
            }
          }
        }
