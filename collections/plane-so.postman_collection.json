{
  "info": {
    "name": "Plane API",
    "description": "REST API for Plane, the open-source project and product management tool. Base URL https://api.plane.so/api/v1. Authenticate with the X-API-Key header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.plane.so/api/v1" },
    { "key": "apiKey", "value": "" },
    { "key": "workspace_slug", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "work_item_id", "value": "" },
    { "key": "cycle_id", "value": "" },
    { "key": "module_id", "value": "" }
  ],
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "List all projects in a workspace.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", ""]
            }
          }
        },
        {
          "name": "Create a project in a workspace.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"identifier\": \"\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", ""]
            }
          }
        },
        {
          "name": "Retrieve a project.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/{{project_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", "{{project_id}}", ""]
            }
          }
        },
        {
          "name": "Update a project.",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/{{project_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", "{{project_id}}", ""]
            }
          }
        },
        {
          "name": "Delete a project.",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspace_slug}}/projects/{{project_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspace_slug}}", "projects", "{{project_id}}", ""]
            }
          }
        }
      ]
    },
